# Copy this file to `.env.admob` and fill your real values locally.
# Do not commit `.env.admob`.

ADMOB_APP_ID_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
ADMOB_BANNER_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx/zzzzzzzzzz
ADMOB_REWARDED_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx/wwwwwwwwww

# Optional (for future iOS release build flow)
ADMOB_APP_ID_IOS=ca-app-pub-xxxxxxxxxxxxxxxx~aaaaaaaaaa
ADMOB_BANNER_IOS=ca-app-pub-xxxxxxxxxxxxxxxx/bbbbbbbbbb
ADMOB_REWARDED_IOS=ca-app-pub-xxxxxxxxxxxxxxxx/cccccccccc
